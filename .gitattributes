# Keep public source diffs stable across Windows, macOS, and Linux.
* text=auto

.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.rgignore text eol=lf
*.json text eol=lf
*.lean text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.tex text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.db binary
*.faiss binary
*.pdf binary
*.png binary
*.sqlite3 binary
